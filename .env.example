# QuickBase API tokens
QB_TOKEN=your_quickbase_token_here
QB_JLTOKEN=your_jl_token_here
QB_SAFETOKEN=your_safe_token_here
QB_TRAFFICTOKEN=your_traffic_token_here

# Azure Blob Storage connection string
AZURE_BLOB_CONNECTION=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ABCpdf License key
ABCPDF_LICENSE=your_abcpdf_license_key_here

# Database connection string
DB_CONNECTION=Server=...;Database=...;User Id=...;Password=...;
